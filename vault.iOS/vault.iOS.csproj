<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-ios16.4</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>vault.iOS</RootNamespace>
    <AssemblyName>vault.iOS</AssemblyName>

    <ApplicationTitle>Cassaforte iOS</ApplicationTitle>
    <ApplicationId>com.luca07giochi.vaultios</ApplicationId>
    <ApplicationDisplayVersion>1.2.3</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchExtraArgs>--gcc_flags "-framework Security -framework CoreFoundation"</MtouchExtraArgs>
    <PublishTrimmed>true</PublishTrimmed>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vault.Core\vault.Core.csproj" />
    <ProjectReference Include="..\vault.iOS.Shared\vault.iOS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.44.0" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="Resources\AppIcon\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </BundleResource>
  </ItemGroup>

  <Target Name="BuildShareExtensionBundle">
    <MSBuild
      Projects="..\vault.iOS.ShareExtension\vault.iOS.ShareExtension.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);BuildIpa=false;CreatePackage=false;EnableCodeSigning=$(EnableCodeSigning);CheckEolWorkloads=false;CheckEolTargetFramework=false" />
  </Target>

  <Target Name="EmbedShareExtensionBundle" AfterTargets="Build" DependsOnTargets="BuildShareExtensionBundle">
    <ItemGroup>
      <_ShareExtensionBundle Include="..\vault.iOS.ShareExtension\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\*.appex" />
    </ItemGroup>

    <Error
      Condition="'@(_ShareExtensionBundle)' == ''"
      Text="Share extension bundle non trovato in vault.iOS.ShareExtension/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)." />

    <Message
      Importance="High"
      Text="Embedding share extension bundle: @(_ShareExtensionBundle) into $(AppBundleDir)PlugIns" />

    <Error
      Condition="'$(AppBundleDir)' == ''"
      Text="AppBundleDir non valorizzata durante l'embed della share extension." />

    <Exec Command="mkdir -p &quot;$(AppBundleDir)PlugIns&quot;" />
    <Exec Command="rm -rf &quot;$(AppBundleDir)PlugIns/%(_ShareExtensionBundle.Filename)%(_ShareExtensionBundle.Extension)&quot;" Condition="Exists('$(AppBundleDir)PlugIns/%(_ShareExtensionBundle.Filename)%(_ShareExtensionBundle.Extension)')" />
    <Exec Command="cp -R &quot;%(_ShareExtensionBundle.FullPath)&quot; &quot;$(AppBundleDir)PlugIns/&quot;" />
  </Target>

</Project>
