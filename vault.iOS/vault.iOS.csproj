<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-ios16.4</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>vault.iOS</RootNamespace>
    <AssemblyName>vault.iOS</AssemblyName>

    <ApplicationTitle>Cassaforte iOS</ApplicationTitle>
    <ApplicationId>com.luca07giochi.vaultios</ApplicationId>
    <ApplicationDisplayVersion>1.2.3</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchExtraArgs>--gcc_flags "-framework Security -framework CoreFoundation"</MtouchExtraArgs>
    <PublishTrimmed>true</PublishTrimmed>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <CheckEolWorkloads>false</CheckEolWorkloads>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vault.Core\vault.Core.csproj" />
    <ProjectReference Include="..\vault.iOS.Shared\vault.iOS.Shared.csproj" />
    <ProjectReference Include="..\vault.iOS.ShareExtension\vault.iOS.ShareExtension.csproj">
      <IsAppExtension>true</IsAppExtension>
      <IsWatchApp>false</IsWatchApp>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.44.0" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="Resources\AppIcon\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </BundleResource>
  </ItemGroup>

</Project>
