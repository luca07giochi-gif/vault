<Window x:Class="vault.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:vault.UI"
        Title="Vault" Height="700" Width="1180"
        Icon="Assets/AppIcon.ico"
        Background="#FF101217" WindowStartupLocation="CenterScreen"
        Topmost="False">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF2A2F3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A4252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="#FF313848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="#FF313848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="#FF313848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True"
                                                  IsHitTestVisible="False"/>

                                <Border Grid.Column="1"
                                        Background="#FF202734"
                                        BorderBrush="#FF313848"
                                        BorderThickness="1,0,0,0">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#FFE7EAF0"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="10"
                                          Height="6"/>
                                </Border>

                                <ToggleButton Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsTabStop="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border x:Name="PopupBorder"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FF171B23"
                                        BorderBrush="#FF4E6286"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#FF1B2331"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF4E6286"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#FF1A212D"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF5A739E"/>
                                <Setter TargetName="PopupBorder" Property="BorderBrush" Value="#FF5A739E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF8A95AA"/>
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF243246"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2F4566"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2A3242"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF3B4F72"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <Setter Property="BorderBrush" Value="#FF6E8CC0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VaultThumbnailItemStyle"
               TargetType="ListViewItem"
               BasedOn="{StaticResource VaultListItemStyle}">
            <Setter Property="Margin" Value="4"/>
        </Style>

        <ItemsPanelTemplate x:Key="ListItemsPanelTemplate">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ThumbnailItemsPanelTemplate">
            <WrapPanel IsItemsHost="True"
                       Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <local:VaultThumbnailConverter x:Key="VaultThumbnailConverter"/>

        <DataTemplate x:Key="ThumbnailItemTemplate">
            <Border Width="170"
                    Height="180"
                    Padding="8"
                    Background="#FF171B23"
                    BorderBrush="#FF313848"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FF202734"
                            CornerRadius="6"
                            BorderBrush="#FF313848"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock Text="{Binding IconEmoji}"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image Source="{Binding Converter={StaticResource VaultThumbnailConverter}, IsAsync=True}"
                                   Stretch="UniformToFill"
                                   Margin="2"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               MaxWidth="150"/>

                    <TextBlock Grid.Row="2"
                               Margin="0,2,0,0"
                               Text="{Binding SizeLabel}"
                               Foreground="#FFB6C0D4"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="MainTitleTextBlock"
                       Text="Virtual Vault"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="LanguageLabelTextBlock"
                           Text="Lingua"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageComboBox"
                          Width="140"
                          SelectionChanged="LanguageComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="SetupPanel" Background="#FF121722" CornerRadius="10" Padding="16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox x:Name="CreateVaultGroupBox" Grid.Column="0" Header="Crea nuovo vault" Foreground="#FFE7EAF0" BorderBrush="#FF313848" Padding="12">
                    <StackPanel>
                        <CheckBox x:Name="CreateProtectWithPasswordCheckBox"
                                  Content="Proteggi con password"
                                  IsChecked="True"
                                  Checked="CreateProtectWithPasswordCheckBox_Changed"
                                  Unchecked="CreateProtectWithPasswordCheckBox_Changed"
                                  Margin="0,0,0,6"/>

                        <TextBlock x:Name="CreateProtectionNoteTextBlock"
                                   Text="Se disattivi la protezione, il vault usera la modalita veloce senza password."
                                   Foreground="#FFB6C0D4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="CreatePasswordLabelTextBlock" Text="Password master" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="CreatePasswordBox"/>

                        <TextBlock x:Name="CreateConfirmPasswordLabelTextBlock" Text="Conferma password" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="CreateConfirmPasswordBox"/>

                        <TextBlock x:Name="CreateFormatLabelTextBlock" Text="Formato vault" Margin="0,12,0,6"/>
                        <ComboBox x:Name="CreateVaultFormatComboBox"
                                  SelectedIndex="0">
                            <ComboBoxItem x:Name="CreateFormatSelectItem" Tag="none" Content="Seleziona"/>
                            <ComboBoxItem x:Name="CreateFormatLegacyItem" Tag="legacy" Content="Compatibile (legacy, max circa 2 GB totali)"/>
                            <ComboBoxItem x:Name="CreateFormatExtendedItem" Tag="extended" Content="Esteso (streaming, oltre 2 GB totali)"/>
                            <ComboBoxItem x:Name="CreateFormatUltraItem" Tag="ultra" Content="Ultra (file singolo oltre 2 GB)"/>
                        </ComboBox>

                        <TextBlock x:Name="CreateFormatNoteTextBlock"
                                   Text="Nota: legacy ed esteso limitano il singolo file a circa 2 GB; ultra supporta file singoli oltre 2 GB."
                                   Foreground="#FFB6C0D4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button x:Name="CreateVaultButton"
                                Content="Crea vault"
                                Click="CreateVault_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="OpenVaultGroupBox" Grid.Column="2" Header="Apri vault esistente" Foreground="#FFE7EAF0" BorderBrush="#FF313848" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="OpenVaultFileLabelTextBlock" Text="File vault" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OpenVaultPathTextBox" IsReadOnly="True" Grid.Column="0"/>
                            <Button x:Name="BrowseVaultButton"
                                    Grid.Column="2"
                                    Content="Sfoglia"
                                    Click="BrowseVault_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,8"
                                    Margin="0"/>
                        </Grid>

                        <TextBlock x:Name="OpenVaultPasswordLabelTextBlock" Text="Password master" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="OpenPasswordBox"
                                     KeyDown="OpenPasswordBox_KeyDown"/>

                        <Button x:Name="OpenVaultButton"
                                Content="Apri vault"
                                Click="OpenVault_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                x:Name="QuickOpenPanel"
                Visibility="Collapsed"
                Background="#FF121722"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,18">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                <TextBlock x:Name="QuickOpenTitleTextBlock"
                           Text="Apri vault selezionato"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="QuickOpenFileLabelTextBlock"
                           Text="File"
                           Foreground="#FFB6C0D4"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="StartupVaultPathText"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <TextBlock x:Name="QuickOpenPasswordLabelTextBlock"
                           Text="Password master"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="StartupVaultPasswordBox"
                             KeyDown="StartupVaultPasswordBox_KeyDown"/>

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="OpenStartupVaultButton"
                            Content="Apri vault"
                            Click="OpenStartupVault_Click"
                            Style="{StaticResource PrimaryButton}"
                            Width="130"
                            Margin="0,0,8,0"/>
                    <Button x:Name="ShowFullHomeButton"
                            Content="Mostra home completa"
                            Click="ShowFullHome_Click"
                            Style="{StaticResource PrimaryButton}"
                            Width="170"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="VaultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="OpenedVaultPathText"
                       Grid.Row="0"
                       FontSize="14"
                       Foreground="#FFB6C0D4"
                       Margin="0,0,0,8"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Button x:Name="FolderUpButton"
                        DockPanel.Dock="Left"
                        Content="&#x2191;"
                        ToolTip="Cartella superiore"
                        Width="60"
                        FontSize="24"
                        FontWeight="Bold"
                        Padding="0"
                        Click="FolderUp_Click"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock x:Name="SortLabelTextBlock"
                               Text="Ordina"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="SortModeComboBox"
                              Width="220"
                              Margin="0,0,8,0"
                              SelectionChanged="SortModeComboBox_SelectionChanged"
                              SelectedIndex="0">
                        <ComboBoxItem x:Name="SortNameItem" Tag="name" Content="Nome"/>
                        <ComboBoxItem x:Name="SortDateItem" Tag="date" Content="Data"/>
                        <ComboBoxItem x:Name="SortSizeItem" Tag="size" Content="Dimensione"/>
                        <ComboBoxItem x:Name="SortTypeItem" Tag="type" Content="Tipo file"/>
                    </ComboBox>
                    <Button x:Name="SortDirectionButton"
                            Width="48"
                            Height="32"
                            Margin="0,0,12,0"
                            Click="SortDirectionButton_Click"
                            Style="{StaticResource PrimaryButton}"
                            Content="A-Z"/>

                    <TextBlock x:Name="ViewModeLabelTextBlock"
                               Text="Vista"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="ViewModeComboBox"
                              Width="150"
                              SelectionChanged="ViewModeComboBox_SelectionChanged"
                              SelectedIndex="0">
                        <ComboBoxItem x:Name="ViewModeListItem" Tag="list" Content="Lista"/>
                        <ComboBoxItem x:Name="ViewModeThumbItem" Tag="thumb" Content="Anteprime"/>
                    </ComboBox>
                </StackPanel>

                <Border VerticalAlignment="Center"
                        Padding="6,4"
                        CornerRadius="6"
                        Background="#FF171B23"
                        BorderBrush="#FF313848"
                        BorderThickness="1"
                        AllowDrop="True"
                        DragOver="BreadcrumbHost_DragOver"
                        Drop="BreadcrumbHost_Drop">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <GroupBox x:Name="FolderContentGroupBox" Grid.Row="2" Header="Contenuto cartella" Foreground="#FFE7EAF0" BorderBrush="#FF313848" Padding="10">
                <Grid>
                    <ListView x:Name="ItemsListView"
                              Background="#FF121722"
                              Foreground="#FFE7EAF0"
                              BorderThickness="0"
                              ItemsPanel="{StaticResource ListItemsPanelTemplate}"
                              ItemContainerStyle="{StaticResource VaultListItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Extended"
                              SelectionChanged="ItemsListView_SelectionChanged"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="ItemsListView_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="ItemsListView_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="ItemsListView_PreviewMouseRightButtonDown"
                              MouseMove="ItemsListView_MouseMove"
                              DragOver="ItemsListView_DragOver"
                              Drop="ItemsListView_Drop"
                              MouseDoubleClick="ItemsListView_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ContextOpenMenuItem" Header="Apri" Click="OpenFile_Click"/>
                                <MenuItem x:Name="ContextExportMenuItem" Header="Esporta" Click="ExportFile_Click"/>
                                <MenuItem x:Name="ContextRenameMenuItem" Header="Rinomina" Click="RenameItem_Click"/>
                                <MenuItem x:Name="ContextMoveMenuItem" Header="Sposta" Click="MoveItems_Click"/>
                                <MenuItem x:Name="ContextDeleteMenuItem" Header="Elimina" Click="RemoveFile_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ContextAddFileMenuItem" Header="Aggiungi file..." Click="AddFile_Click"/>
                                <MenuItem x:Name="ContextNewFolderMenuItem" Header="Nuova cartella" Click="NewFolder_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ContextRefreshMenuItem" Header="Aggiorna" Click="RefreshFolder_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3B4F72"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2A3242"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFFFF"/>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn x:Name="NameColumn" Header="Nome" Width="440">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconEmoji}" Margin="0,0,8,0" FontSize="15"/>
                                                <TextBlock Text="{Binding FileName}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="TypeColumn" Header="Tipo" DisplayMemberBinding="{Binding ItemTypeLabel}" Width="110"/>
                                <GridViewColumn x:Name="SizeColumn" Header="Dimensione" DisplayMemberBinding="{Binding SizeLabel}" Width="120"/>
                                <GridViewColumn x:Name="AddedColumn" Header="Aggiunto" DisplayMemberBinding="{Binding AddedAtLabel}" Width="170"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="SelectionMarquee"
                                Visibility="Collapsed"
                                BorderBrush="#FF87A7DB"
                                BorderThickness="1"
                                Background="#3387A7DB"/>
                    </Canvas>
                </Grid>
            </GroupBox>

            <TextBlock x:Name="DragHintTextBlock"
                       Grid.Row="3"
                       Margin="0,8,0,0"
                       Foreground="#FFB6C0D4"
                       Text="Suggerimento: trascina file esterni qui per aggiungerli. Trascina file/cartelle del vault su una cartella per spostarli."/>

            <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0" ItemHeight="34">
                <Button x:Name="AddFileButton"
                        Content="Aggiungi file"
                        Click="AddFile_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="120" Margin="0,0,8,0"/>

                <Button x:Name="NewFolderButton"
                        Content="Nuova cartella"
                        Click="NewFolder_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="130" Margin="0,0,8,0"/>

                <Button x:Name="MoveItemsButton"
                        Content="Sposta"
                        Click="MoveItems_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="90" Margin="0,0,8,0"/>

                <Button x:Name="RenameItemButton"
                        Content="Rinomina"
                        Click="RenameItem_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="100" Margin="0,0,8,0"/>

                <Button x:Name="RemoveFileButton"
                        Content="Rimuovi"
                        Click="RemoveFile_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="100" Margin="0,0,8,0"/>

                <Button x:Name="ExportFileButton"
                        Content="Esporta"
                        Click="ExportFile_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="90" Margin="0,0,8,0"/>

                <Button x:Name="OpenFileButton"
                        Content="Apri"
                        Click="OpenFile_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="80" Margin="0,0,8,0"/>

                <Button x:Name="VaultSettingsButton"
                        Content="Impostazioni vault"
                        Click="VaultSettings_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="150" Margin="0,0,8,0"/>

                <Button x:Name="CloseVaultButton"
                        Content="Chiudi vault"
                        Click="CloseVault_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        Background="#FF572424"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
