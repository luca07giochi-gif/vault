<Window x:Class="vault.UI.MoveItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sposta elementi"
        Height="520"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF101217">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="#FF2A2F3A"/>
            <Setter Property="BorderBrush" Value="#FF3C4251"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A4252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionTextBlock"
                   Grid.Row="0"
                   Foreground="#FFE7EAF0"
                   FontSize="14"
                   Margin="0,0,0,10"
                   Text="Seleziona la cartella di destinazione. Puoi creare nuove cartelle annidate."/>

        <Border Grid.Row="1"
                BorderBrush="#FF313848"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FF171B23"
                Padding="8">
            <TreeView x:Name="FolderTreeView"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#FFE7EAF0"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="NewFolderButton"
                    Content="Nuova cartella"
                    Width="130"
                    DockPanel.Dock="Left"
                    Style="{StaticResource ActionButton}"
                    Click="NewFolder_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Annulla"
                        Width="100"
                        Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmMoveButton"
                        Content="Sposta"
                        Width="110"
                        Style="{StaticResource ActionButton}"
                        Background="#FF2E4B7A"
                        IsDefault="True"
                        Click="ConfirmMove_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
