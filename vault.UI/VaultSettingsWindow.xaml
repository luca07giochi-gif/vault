<Window x:Class="vault.UI.VaultSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni Vault"
        Height="440"
        Width="500"
        Background="#FF101217"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="#FF2A2F3A"/>
            <Setter Property="BorderBrush" Value="#FF3C4251"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A4252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="#FF313848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="BorderBrush" Value="#FF313848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True"
                                                  IsHitTestVisible="False"/>

                                <Border Grid.Column="1"
                                        Background="#FF202734"
                                        BorderBrush="#FF313848"
                                        BorderThickness="1,0,0,0">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#FFE7EAF0"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="10"
                                          Height="6"/>
                                </Border>

                                <ToggleButton Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsTabStop="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border x:Name="PopupBorder"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FF171B23"
                                        BorderBrush="#FF4E6286"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#FF1B2331"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF4E6286"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#FF1A212D"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF5A739E"/>
                                <Setter TargetName="PopupBorder" Property="BorderBrush" Value="#FF5A739E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF8A95AA"/>
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF171B23"/>
            <Setter Property="Foreground" Value="#FFE7EAF0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#FF243246"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF243246"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2F4566"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   Text="Impostazioni vault"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"/>

        <TextBlock x:Name="PasswordHeaderTextBlock"
                   Grid.Row="1"
                   Text="Cambio password (opzionale)"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="NewPasswordLabelTextBlock" Text="Nuova password master" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewPasswordBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ConfirmPasswordLabelTextBlock" Text="Conferma nuova password" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordBox"/>
        </StackPanel>

        <Separator Grid.Row="4" Margin="0,16,0,12" Background="#FF313848"/>

        <StackPanel Grid.Row="5">
            <TextBlock x:Name="FormatHeaderTextBlock" Text="Conversione formato vault" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="CurrentFormatTextBlock"
                       Foreground="#FFB6C0D4"
                       Margin="0,4,0,8"/>

            <TextBlock x:Name="NewFormatLabelTextBlock" Text="Nuovo formato"/>
            <ComboBox x:Name="StorageFormatComboBox" Margin="0,6,0,0">
                <ComboBoxItem x:Name="StorageFormatLegacyItem" Tag="legacy" Content="Compatibile (legacy, max circa 2 GB totali)"/>
                <ComboBoxItem x:Name="StorageFormatExtendedItem" Tag="extended" Content="Esteso (streaming, oltre 2 GB totali)"/>
                <ComboBoxItem x:Name="StorageFormatUltraItem" Tag="ultra" Content="Ultra (file singolo oltre 2 GB)"/>
            </ComboBox>

            <TextBlock x:Name="FormatNoteTextBlock"
                       Text="Nota: legacy ed esteso limitano il singolo file a circa 2 GB; ultra supporta file singoli oltre 2 GB."
                       Foreground="#FFB6C0D4"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Annulla"
                    Width="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButton}"
                    Click="Cancel_Click"/>
            <Button x:Name="ApplyButton"
                    Content="Applica"
                    Width="130"
                    Style="{StaticResource ActionButton}"
                    Background="#FF2E4B7A"
                    Click="Save_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
