<Window x:Class="vault.UI.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Height="190"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF101217">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="#FF2A2F3A"/>
            <Setter Property="BorderBrush" Value="#FF3C4251"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A4252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock"
                   Grid.Row="0"
                   Foreground="#FFE7EAF0"
                   FontSize="14"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="ValueTextBox"
                 Grid.Row="1"
                 Background="#FF171B23"
                 Foreground="#FFE7EAF0"
                 BorderBrush="#FF313848"
                 BorderThickness="1"
                 Padding="8,6"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton"
                    Content="Annulla"
                    Width="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButton}"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton"
                    Content="Conferma"
                    Width="120"
                    Style="{StaticResource ActionButton}"
                    Background="#FF2E4B7A"
                    Click="Confirm_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
