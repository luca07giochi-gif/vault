<Window x:Class="vault.UI.RenameItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rinomina"
        Height="300"
        MinHeight="300"
        Width="470"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#FF101217">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="#FF2A2F3A"/>
            <Setter Property="BorderBrush" Value="#FF3C4251"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A4252"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TitleTextBlock"
                   Foreground="#FFE7EAF0"
                   FontWeight="SemiBold"
                   FontSize="18"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="NameLabelTextBlock" Text="Nome file" Foreground="#FFE7EAF0" Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox"
                     Background="#FF171B23"
                     Foreground="#FFE7EAF0"
                     BorderBrush="#FF313848"
                     BorderThickness="1"
                     Padding="8,6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" x:Name="ExtensionPanel">
            <TextBlock x:Name="ExtensionLabelTextBlock" Text="Estensione" Foreground="#FFE7EAF0" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="."
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="#FFE7EAF0"/>
                <TextBox x:Name="ExtensionTextBox"
                         Grid.Column="1"
                         Background="#FF171B23"
                         Foreground="#FFE7EAF0"
                         BorderBrush="#FF313848"
                         BorderThickness="1"
                         Padding="8,6"/>
            </Grid>
            <TextBlock x:Name="ExtensionHintTextBlock"
                       Text="Usa solo lettere e numeri (esempio: pdf, jpg, docx)"
                       Foreground="#FFB6C0D4"
                       Margin="0,4,0,0"
                       FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Annulla"
                    Width="100"
                    Margin="0,0,8,0"
                    Style="{StaticResource ActionButton}"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmRenameButton"
                    Content="Conferma modifica"
                    Width="170"
                    Style="{StaticResource ActionButton}"
                    Background="#FF2E4B7A"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
