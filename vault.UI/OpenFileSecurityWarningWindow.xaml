<Window x:Class="vault.UI.OpenFileSecurityWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avviso sicurezza apertura file"
        Height="260"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF101217">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="BodyTextBlock"
                   Grid.Row="0"
                   Foreground="#FFE7EAF0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Text="Per aprire un file, il vault crea una copia temporanea in chiaro sul disco.&#x0a;&#x0a;La copia viene cancellata automaticamente quando possibile, ma alcune applicazioni possono mantenere cache o lock per un certo periodo."/>

        <CheckBox Grid.Row="1"
                  x:Name="DoNotShowAgainCheckBox"
                  Content="Non mostrare piu"
                  Foreground="#FFE7EAF0"
                  Margin="0,14,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Annulla"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="ContinueButton"
                    Content="Continua"
                    Width="100"
                    IsDefault="True"
                    Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
